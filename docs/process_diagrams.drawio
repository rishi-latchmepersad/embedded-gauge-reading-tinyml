<mxfile host="Electron" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) draw.io/28.1.2 Chrome/138.0.7204.243 Electron/37.4.0 Safari/537.36" pages="2">
  <diagram id="6fHF2__YJ60N_B--ARtN" name="AI_Process">
    <mxGraphModel dx="1144" dy="802" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="cnn_title_why" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontStyle=1;fontSize=16;" value="Why each step is performed" vertex="1">
          <mxGeometry height="30" width="360" y="680" as="geometry" />
        </mxCell>
        <mxCell id="cnn_tech_1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;fillColor=#dae8fc;strokeColor=#6c8ebf;image=process_diagrams_assets/cnn_01_capture.svg;imageAlign=right;imageVerticalAlign=middle;imageWidth=48;imageHeight=48;spacingRight=58;spacingLeft=10;" value="IMX335 capture and shared snapshot&lt;br&gt;- Capture thread waits for FileX media readiness&lt;br&gt;- AE settles/locks; brightness gate can nudge exposure/gain and retry&lt;br&gt;- Accepted 224x224 YUV422 frame is shared with AI and baseline" vertex="1">
          <mxGeometry height="170" width="270" x="40" y="90" as="geometry" />
        </mxCell>
        <mxCell id="cnn_tech_2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;fillColor=#d5e8d4;strokeColor=#82b366;image=process_diagrams_assets/cnn_02_brightness.svg;imageAlign=right;imageVerticalAlign=middle;imageWidth=48;imageHeight=48;spacingRight=58;spacingLeft=10;" value="Persist capture and queue workers&lt;br&gt;- Write timestamped capture_YYYY-MM-DD_HH-MM-SS.yuv422 under /captured_images/&lt;br&gt;- Stamp FAT modified time on the file&lt;br&gt;- Queue AI dry-run and baseline work from the same snapshot; FileX flush runs every 120 s" vertex="1">
          <mxGeometry height="170" width="280" x="350" y="90" as="geometry" />
        </mxCell>
        <mxCell id="cnn_tech_3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;fillColor=#a0522d;strokeColor=#6D1F00;image=process_diagrams_assets/cnn_03_obb_localizer.svg;imageAlign=right;imageVerticalAlign=middle;imageWidth=48;imageHeight=48;spacingRight=58;spacingLeft=10;fontColor=#ffffff;" value="Flashed OBB localizer&lt;br&gt;- Preprocess full 224x224 frame and run the OBB package&lt;br&gt;- Decode score/raw output and center-size box&lt;br&gt;- Use the OBB crop when valid; otherwise use the fixed training crop" vertex="1">
          <mxGeometry height="170" width="300" x="670" y="90" as="geometry" />
        </mxCell>
        <mxCell id="cnn_tech_4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;fillColor=#0050ef;strokeColor=#001DBC;image=process_diagrams_assets/cnn_04_crop_selection.svg;imageAlign=right;imageVerticalAlign=middle;imageWidth=48;imageHeight=48;spacingRight=58;spacingLeft=10;fontColor=#ffffff;" value="Canonical crop handoff&lt;br&gt;- Validate, clamp, and resize the selected OBB crop&lt;br&gt;- Maintain cache/preprocess diagnostics and xSPI2 stage state&lt;br&gt;- The fixed crop remains the explicit fallback when OBB decoding is unusable" vertex="1">
          <mxGeometry height="170" width="290" x="1010" y="90" as="geometry" />
        </mxCell>
        <mxCell id="cnn_tech_5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;fillColor=#d5e8d4;strokeColor=#82b366;image=process_diagrams_assets/cnn_05_geometry_keypoints.svg;imageAlign=right;imageVerticalAlign=middle;imageWidth=48;imageHeight=48;spacingRight=58;spacingLeft=10;" value="Flashed tip-focus v18 geometry model&lt;br&gt;- Input: 224x224 canonical crop&lt;br&gt;- Decode 56x56 center/tip heatmaps plus confidence and is_main_needle&lt;br&gt;- Quantized sigmoid fallbacks remain visible in diagnostics" vertex="1">
          <mxGeometry height="170" width="300" x="1340" y="90" as="geometry" />
        </mxCell>
        <mxCell id="cnn_tech_6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;fillColor=#e1d5e7;strokeColor=#9673a6;image=process_diagrams_assets/cnn_06_angle_to_temperature.svg;imageAlign=right;imageVerticalAlign=middle;imageWidth=48;imageHeight=48;spacingRight=58;spacingLeft=10;" value="Angle, temperature, metrics, and logs&lt;br&gt;- Convert center-tip geometry to raw/gauge angle&lt;br&gt;- Apply calibrated 270° sweep and board temperature map&lt;br&gt;- Log inference/metrics/power to SD/UART while watchdog pulses independently" vertex="1">
          <mxGeometry height="170" width="280" x="1680" y="90" as="geometry" />
        </mxCell>
        <mxCell id="cnn_why_1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="Capture is the common input boundary. Exposure settling and the brightness retry gate protect both consumers, while the copied snapshot prevents the AI and baseline workers from racing the camera buffer." vertex="1">
          <mxGeometry height="190" width="270" x="40" y="480" as="geometry" />
        </mxCell>
        <mxCell id="cnn_why_2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="The capture cadence is one frame per minute, but storage is intentionally decoupled: each image is named with the RTC date/time, its FAT timestamp is set, and media flush is serviced on the two-minute schedule." vertex="1">
          <mxGeometry height="190" width="280" x="350" y="480" as="geometry" />
        </mxCell>
        <mxCell id="cnn_why_3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="OBB is the live AI localizer. The board logs its epochs, score, and decoded crop, so a bad crop can be distinguished from a tip-focus failure rather than hidden inside one opaque model step." vertex="1">
          <mxGeometry height="190" width="300" x="670" y="480" as="geometry" />
        </mxCell>
        <mxCell id="cnn_why_4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="The handoff is explicit: the OBB worker selects a live crop or fixed fallback, then the tip-focus worker receives a known 224x224 input. This keeps crop selection and needle geometry independently diagnosable." vertex="1">
          <mxGeometry height="190" width="290" x="1010" y="480" as="geometry" />
        </mxCell>
        <mxCell id="cnn_why_5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="AI is still a separate flashed inference path from the classical baseline. The current runtime exposes the actual output tensors and quantized fallbacks, which is important when validating that the AI result—not the baseline—is the trusted reading." vertex="1">
          <mxGeometry height="190" width="300" x="1340" y="480" as="geometry" />
        </mxCell>
        <mxCell id="cnn_why_6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="The final angle conversion is deterministic, but the logs preserve the raw angle, mapped value, exact value, power, and timing. That makes model, crop, and calibration problems separable during board testing." vertex="1">
          <mxGeometry height="190" width="280" x="1680" y="480" as="geometry" />
        </mxCell>
        <mxCell id="cnn_e1" edge="1" parent="1" source="cnn_tech_1" style="endArrow=block;html=1;strokeColor=#000000;" target="cnn_tech_2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cnn_e2" edge="1" parent="1" source="cnn_tech_2" style="endArrow=block;html=1;strokeColor=#000000;" target="cnn_tech_3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cnn_e3" edge="1" parent="1" source="cnn_tech_3" style="endArrow=block;html=1;strokeColor=#000000;" target="cnn_tech_4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
