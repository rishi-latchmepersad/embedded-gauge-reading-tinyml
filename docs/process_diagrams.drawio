        <mxCell id="cnn_w4" edge="1" parent="1" source="zElmDHNvidVek9H3AHMp-7" style="dashed=1;endArrow=none;html=1;strokeColor=#d79b00;" target="cnn_why_4">
          <mxGeometry relative="1" as="geometry" />
