  </diagram>
  <diagram id="classicalCVBaseline01" name="Classical_CV_Baseline_Process">
    <mxGraphModel dx="964" dy="674" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="cv_title_tech" value="Current Classical Firmware Baseline (template + polar + Hough)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontStyle=1;fontSize=16;" parent="1" vertex="1">
          <mxGeometry y="30" width="560" height="30" as="geometry" />
        </mxCell>
        <mxCell id="cv_tech_1" value="Shared YUV422 frame and brightness profile&lt;br&gt;- Baseline worker consumes the copied 224x224 frame&lt;br&gt;- Profiles mean luma and bright-pixel ratio; low-light frames can reject early&lt;br&gt;- Runs concurrently with AI and never consumes the AI result" style="rounded=1;whiteSpace=wrap;html=1;align=center;fillColor=#d5e8d4;strokeColor=#82b366;image=process_diagrams_assets/cv_01_yuv422_snapshot.svg;imageAlign=right;imageVerticalAlign=middle;imageWidth=48;imageHeight=48;spacingRight=58;spacingLeft=10;" parent="1" vertex="1">
          <mxGeometry x="40" y="90" width="240" height="200" as="geometry" />
        </mxCell>
        <mxCell id="cv_tech_2" value="Mimo normalized-template first pass&lt;br&gt;- Build a normalized 8x8 luma descriptor&lt;br&gt;- Compare against the board template bank&lt;br&gt;- Strong matches can publish directly after the generic acceptance gate&lt;br&gt;- Weak matches log template-match-rejected-weak and continue to polar fallbacks" style="rounded=1;whiteSpace=wrap;html=1;align=center;fillColor=#d5e8d4;strokeColor=#82b366;image=process_diagrams_assets/cv_02_center_hypotheses.svg;imageAlign=right;imageVerticalAlign=middle;imageWidth=48;imageHeight=48;spacingRight=58;spacingLeft=10;" parent="1" vertex="1">
          <mxGeometry x="320" y="90" width="320" height="200" as="geometry" />
        </mxCell>
        <mxCell id="cv_tech_3" value="Legacy five-hypothesis polar path&lt;br&gt;- On weak template matches, test bright-center, fixed-crop, board-prior, rim-center, and image-center seeds&lt;br&gt;- Vote over 360 polar bins for a dark spoke&lt;br&gt;- Use saturation/subdial masks, shaft weighting, radial/tangential alignment, hub/tip continuity, and hot-zone rescue" style="rounded=1;whiteSpace=wrap;html=1;align=center;fillColor=#d5e8d4;strokeColor=#82b366;image=process_diagrams_assets/cv_03_hough_votes.svg;imageAlign=right;imageVerticalAlign=middle;imageWidth=48;imageHeight=48;spacingRight=58;spacingLeft=10;" parent="1" vertex="1">
          <mxGeometry x="680" y="90" width="320" height="200" as="geometry" />
        </mxCell>
        <mxCell id="cv_tech_4" value="Refine, select, then try dynamic Hough&lt;br&gt;- Refine accepted polar seeds over a local 5x5 geometry sweep&lt;br&gt;- Compare source priority, peak quality, and consensus&lt;br&gt;- Only if all primary hypotheses fail, run dynamic rim/face-center radial Hough over 360 rays&lt;br&gt;- Hough gate: score ≥ 8 and peak ratio ≥ 1.15" style="rounded=1;whiteSpace=wrap;html=1;align=center;fillColor=#d5e8d4;strokeColor=#82b366;image=process_diagrams_assets/cv_04_confidence_selection.svg;imageAlign=right;imageVerticalAlign=middle;imageWidth=48;imageHeight=48;spacingRight=58;spacingLeft=10;" parent="1" vertex="1">
          <mxGeometry x="1030" y="90" width="320" height="200" as="geometry" />
        </mxCell>
        <mxCell id="cv_tech_5" value="Current-frame stability gate&lt;br&gt;- Check confidence, peak separation, center/jump limits, and candidate validity&lt;br&gt;- Only a stable current estimate enters the three-frame history&lt;br&gt;- Unstable frames return estimate-unstable; stale history is not substituted" style="rounded=1;whiteSpace=wrap;html=1;align=center;fillColor=#d5e8d4;strokeColor=#82b366;image=process_diagrams_assets/cv_05_threshold_gate.svg;imageAlign=right;imageVerticalAlign=middle;imageWidth=48;imageHeight=48;spacingRight=58;spacingLeft=10;" parent="1" vertex="1">
          <mxGeometry x="1390" y="90" width="300" height="200" as="geometry" />
        </mxCell>
        <mxCell id="cv_tech_6" value="Publish accepted estimate or fail closed&lt;br&gt;- Accepted frames log RAW angle/source, smooth history, map 135°..405° over 270° to -30°C..+50°C, and publish metrics&lt;br&gt;- Failed frames log estimate-failed or selection-failed and temp=nan&lt;br&gt;- The baseline does not claim a reading when it cannot trust the frame" style="rounded=1;whiteSpace=wrap;html=1;align=center;fillColor=#d5e8d4;strokeColor=#82b366;image=process_diagrams_assets/cv_06_angle_to_temperature.svg;imageAlign=right;imageVerticalAlign=middle;imageWidth=48;imageHeight=48;spacingRight=58;spacingLeft=10;" parent="1" vertex="1">
          <mxGeometry x="1730" y="90" width="290" height="200" as="geometry" />
        </mxCell>
        <mxCell id="cv_why_1" value="The baseline sees the same copied frame as AI, but it is a separate classical worker. That makes timing and failures visible independently instead of letting a baseline heuristic alter the AI input." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
          <mxGeometry x="40" y="480" width="240" height="220" as="geometry" />
        </mxCell>
        <mxCell id="cv_why_2" value="The template pass is board-specific and cheap, but it is guarded because weak matches were producing plausible-looking wrong angles. A weak score moves the frame into the classical fallback path instead of being silently accepted." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
          <mxGeometry x="320" y="480" width="320" height="220" as="geometry" />
        </mxCell>
        <mxCell id="cv_why_3" value="This is the older editable-diagram polar detector still present in firmware. It has several center hypotheses and many hand-tuned cues, so it is useful diagnostically, but the diagram should not imply that it is a reliable learned detector." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
          <mxGeometry x="680" y="480" width="310" height="220" as="geometry" />
        </mxCell>
        <mxCell id="cv_why_4" value="The dynamic Hough fallback is Mimo's later addition to recover a face center and needle ray without trusting the fixed center. It is deliberately last-resort: the runtime reaches it only after the template and primary polar hypotheses fail their gates." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
          <mxGeometry x="1030" y="480" width="320" height="220" as="geometry" />
        </mxCell>
        <mxCell id="cv_why_5" value="The current-frame gate is intentionally fail-closed. History can smooth accepted frames, but an unstable current frame is rejected rather than converted into a stale-looking temperature; the board log exposes estimate-unstable." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
          <mxGeometry x="1390" y="480" width="300" height="220" as="geometry" />
        </mxCell>
        <mxCell id="cv_why_6" value="Angle-to-temperature is deterministic only after a candidate passes the baseline gates. The explicit reject path is part of the current behavior and is why a failed frame can report temp=nan instead of manufacturing a reading." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
          <mxGeometry x="1730" y="470" width="290" height="220" as="geometry" />
        </mxCell>
        <mxCell id="cve1" style="endArrow=block;html=1;strokeColor=#000000;" parent="1" source="cv_tech_1" target="cv_tech_2" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cve2" style="endArrow=block;html=1;strokeColor=#000000;" parent="1" source="cv_tech_2" target="cv_tech_3" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cve3" style="endArrow=block;html=1;strokeColor=#000000;" parent="1" source="cv_tech_3" target="cv_tech_4" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cve4" style="endArrow=block;html=1;strokeColor=#000000;" parent="1" source="cv_tech_4" target="cv_tech_5" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cve5" style="endArrow=block;html=1;strokeColor=#000000;" parent="1" source="cv_tech_5" target="cv_tech_6" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cvw2" style="dashed=1;endArrow=none;html=1;strokeColor=#d79b00;" parent="1" source="kAxTJiGilQFAcQdgw8WS-3" target="cv_why_2" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cvw3" style="dashed=1;endArrow=none;html=1;strokeColor=#d79b00;" parent="1" source="kAxTJiGilQFAcQdgw8WS-5" target="cv_why_3" edge="1">
