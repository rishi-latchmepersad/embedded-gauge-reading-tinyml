<mxfile host="Electron" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) draw.io/28.1.2 Chrome/138.0.7204.243 Electron/37.4.0 Safari/537.36" pages="4">
  <diagram id="6fHF2__YJ60N_B--ARtN" name="AI_Process">
    <mxGraphModel dx="2020" dy="1201" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="cnn_tech_1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;fillColor=#dae8fc;strokeColor=#6c8ebf;image=process_diagrams_assets/cnn_01_capture.svg;imageAlign=right;imageVerticalAlign=middle;imageWidth=48;imageHeight=48;spacingRight=58;spacingLeft=10;" value="&lt;b&gt;Capture a usable gauge image&lt;/b&gt;&lt;br&gt;- Capture a new image of the gauge every 1 min using the IMX sensor&lt;div&gt;- The sensor is 5MP, but we downscale it to 640x640 for easier processing&lt;br&gt;- We also discard the colour data and only keep grayscale information to keep processing light&lt;/div&gt;" vertex="1">
          <mxGeometry height="190" width="270" x="40" y="90" as="geometry" />
        </mxCell>
        <mxCell id="cnn_tech_2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;fillColor=#d5e8d4;strokeColor=#82b366;image=process_diagrams_assets/cnn_02_brightness.svg;imageAlign=right;imageVerticalAlign=middle;imageWidth=48;imageHeight=48;spacingRight=58;spacingLeft=10;" value="&lt;b&gt;Apply a confidence gate&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;- Check that the gauge area is bright and clear enough to read (by measuring average lumens)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;- If the image is too dark, too bright, or unstable, discard it&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;- Only a usable image moves into the reading pipeline&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;- Store the accepted image on the SD card for later diagnosis and testing&lt;/span&gt;" vertex="1">
          <mxGeometry height="190" width="280" x="350" y="90" as="geometry" />
        </mxCell>
        <mxCell id="cnn_tech_3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;fillColor=#a0522d;strokeColor=#6D1F00;image=process_diagrams_assets/cnn_03_ellipse_localizer_v2.svg;imageAlign=right;imageVerticalAlign=middle;imageWidth=48;imageHeight=48;spacingRight=58;spacingLeft=10;fontColor=#ffffff;" value="&lt;b&gt;Find the gauge face&lt;/b&gt;&lt;br&gt;- Locate the circular gauge face in the image using the first ML model (the ellipse model)&lt;br&gt;- Estimate its center, shape, and our confidence in it&lt;br&gt;- If the location is uncertain, we use the known training view/position as a fallback" vertex="1">
          <mxGeometry height="190" width="300" x="670" y="90" as="geometry" />
        </mxCell>
        <mxCell id="cnn_tech_4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;fillColor=#0050ef;strokeColor=#001DBC;image=process_diagrams_assets/cnn_04_crop_selection.svg;imageAlign=right;imageVerticalAlign=middle;imageWidth=48;imageHeight=48;spacingRight=58;spacingLeft=10;fontColor=#ffffff;" value="&lt;b&gt;Prepare a standard view of the gauge&lt;/b&gt;&lt;br&gt;- Crop and resize the gauge face into view using the ellipse model, and discard the rest of the image composition&lt;br&gt;- Use the located face when the model is confident in its detection&lt;br&gt;- Otherwise, we use the fixed view used during training" vertex="1">
          <mxGeometry height="190" width="290" x="1010" y="90" as="geometry" />
        </mxCell>
        <mxCell id="cnn_tech_5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;fillColor=#d5e8d4;strokeColor=#82b366;image=process_diagrams_assets/cnn_05_geometry_keypoints.svg;imageAlign=right;imageVerticalAlign=middle;imageWidth=48;imageHeight=48;spacingRight=58;spacingLeft=10;" value="&lt;b&gt;Find the center and the needle tip&lt;/b&gt;&lt;br&gt;- Use the second ML model (the geometry model) to identify the needle center and tip&lt;br&gt;- Try to not accidently identify the counterweight&lt;br&gt;- The model also gives us heatmap strengths so we can reject uncertain readings" vertex="1">
          <mxGeometry height="190" width="300" x="1340" y="90" as="geometry" />
        </mxCell>
        <mxCell id="cnn_tech_6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;fillColor=#e1d5e7;strokeColor=#9673a6;image=process_diagrams_assets/cnn_06_angle_to_temperature.svg;imageAlign=right;imageVerticalAlign=middle;imageWidth=48;imageHeight=48;spacingRight=58;spacingLeft=10;" value="&lt;b&gt;Turn the angle into a measurement&lt;/b&gt;&lt;br&gt;- Measure the needle angle using north as 0 degrees&lt;br&gt;- The active gauge profile maps that angle to the right quantity and unit&lt;br&gt;- We wait for three consistent readings before accepting a large change&lt;br&gt;- We record the profile, angle, value, unit, and confidence so we can explain the result" vertex="1">
          <mxGeometry height="190" width="280" x="1680" y="90" as="geometry" />
        </mxCell>
        <mxCell id="cnn_e1" edge="1" parent="1" source="cnn_tech_1" style="endArrow=block;html=1;strokeColor=#000000;" target="cnn_tech_2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cnn_e2" edge="1" parent="1" source="cnn_tech_2" style="endArrow=block;html=1;strokeColor=#000000;" target="cnn_tech_3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cnn_e3" edge="1" parent="1" source="cnn_tech_3" style="endArrow=block;html=1;strokeColor=#000000;" target="cnn_tech_4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cnn_e4" edge="1" parent="1" source="cnn_tech_4" style="endArrow=block;html=1;strokeColor=#000000;" target="cnn_tech_5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cnn_e5" edge="1" parent="1" source="cnn_tech_5" style="endArrow=block;html=1;strokeColor=#000000;" target="cnn_tech_6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="zElmDHNvidVek9H3AHMp-2" edge="1" parent="1" source="cnn_tech_1" style="dashed=1;endArrow=none;html=1;strokeColor=#d79b00;" target="zElmDHNvidVek9H3AHMp-1" value="">
