  <diagram id="ellipseModelV1" name="Ellipse_Model">
    <mxGraphModel dx="1768" dy="1051" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1820" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="ell_title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontStyle=1;fontSize=26;fontColor=#243447;" value="Ellipse Localizer Model Architecture" vertex="1">
          <mxGeometry height="44" width="1500" x="40" y="28" as="geometry" />
        </mxCell>
        <mxCell id="ell_subtitle" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;fontColor=#52606d;" value="The first model in the deployed two-stage vision pipeline: full-frame gauge-face localization. We use this to try to locate the gauge in the image captured." vertex="1">
          <mxGeometry height="34" width="1680" x="40" y="78" as="geometry" />
        </mxCell>
        <mxCell id="ell_input" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontColor=#243447;" value="&lt;b&gt;Captured Board frame&lt;/b&gt;&lt;br&gt;640 × 640&lt;br&gt;MONO_Y8&lt;br&gt;One grayscale channel&lt;br&gt;&lt;br&gt;(We capture the full camera frame, but only keep greyscale information for reduced memory requirements as most gauge needles don&#39;t need colour)" vertex="1">
          <mxGeometry height="300" width="190" x="40" y="165" as="geometry" />
        </mxCell>
        <mxCell id="ell_pre" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontColor=#243447;" value="&lt;b&gt;Firmware preprocessing&lt;/b&gt;&lt;br&gt;Bilinear resize of image&lt;br&gt;640 × 640 → 384 × 384&lt;br&gt;&lt;br&gt;Quantize to signed int8&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;(For reduced memory requirements during processing)&lt;/div&gt;" vertex="1">
          <mxGeometry height="300" width="200" x="250" y="165" as="geometry" />
        </mxCell>
        <mxCell id="ell_encoder" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;fillColor=#e1f0ff;strokeColor=#6c8ebf;fontSize=14;fontColor=#243447;" value="&lt;b&gt;Shared CNN encoder&lt;/b&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;Six downsample + refine stages&lt;br&gt;Each encoder stage uses Conv2D 3 × 3 + batch normalization + ReLU&lt;br&gt;&lt;br&gt;Channels:&lt;br&gt;24 → 32 → 48 → 64 → 96 → 128&lt;br&gt;&lt;br&gt;Feature sizes:&lt;br&gt;192 → 96 → 48 → 24 → 12 → 6&lt;br&gt;&lt;br&gt;(We allow the network to learn more abstract/generalized patterns while shrinking finer details. We maintain skip features for later decoding.)&lt;/div&gt;" vertex="1">
          <mxGeometry height="300" width="245" x="470" y="165" as="geometry" />
        </mxCell>
        <mxCell id="ell_decoder" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;fillColor=#e6dff0;strokeColor=#9673a6;fontSize=14;fontColor=#243447;" value="&lt;b&gt;Multiscale decoder&lt;/b&gt;&lt;br&gt;&lt;br&gt;Nearest-neighbor upsample, then concatenate matching encoder skip features&lt;br&gt;&lt;br&gt;Prediction scales:&lt;br&gt;24 × 24 → 48 × 48 → 96 × 96&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;(Turn the features back into spatial predictions of ellipses through upsampling of the patterns learnt and the retained skip features.)&lt;/div&gt;" vertex="1">
          <mxGeometry height="300" width="240" x="735" y="165" as="geometry" />
        </mxCell>
        <mxCell id="ell_heads" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontColor=#243447;" value="&lt;p&gt;&lt;strong&gt;Three predictions at each scale&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;At 24×24, 48×48, and 96×96, we predict a center heatmap, an ellipse-rim heatmap, and ellipse geometry &lt;code dir=&quot;ltr&quot;&gt;(cx, cy, rx, ry)&lt;/code&gt;.  &lt;/p&gt;&lt;p&gt;(A scale score chooses which scale’s estimate to use. The 96×96 output has the finest grid; the model is trained to favor it for smaller-looking gauges and coarser outputs for larger ones.)&lt;/p&gt;" vertex="1">
          <mxGeometry height="300" width="250" x="995" y="165" as="geometry" />
        </mxCell>
        <mxCell id="ell_decode" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;fillColor=#fce5cd;strokeColor=#d79b00;fontSize=14;fontColor=#243447;" value="&lt;b&gt;Choose and check the ellipse&lt;/b&gt;&lt;div&gt;&lt;p&gt;Compare the scores for 24×24, 48×48, and 96×96. Use the ellipse estimate from the highest-scoring scale.  &lt;/p&gt;&lt;p&gt;Find the center from its heatmap, giving stronger cells much more weight.&lt;/p&gt;&lt;p&gt;Use that scale’s geometry estimate for the ellipse radii.  &lt;/p&gt;&lt;p&gt;Reject the result if either radius is under 4 pixels in the original image.&lt;/p&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="300" width="250" x="1265" y="165" as="geometry" />
        </mxCell>
        <mxCell id="ell_crop" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontColor=#243447;" value="&lt;b&gt;Ellipse output → next stage&lt;/b&gt;&lt;br&gt;Convert normalized ellipse to 640-frame pixels&lt;br&gt;&lt;br&gt;Square crop side = 1.35 × max(2rx, 2ry); clip to image bounds&lt;br&gt;&lt;br&gt;Resize crop to 224 × 224 for the center/tip heatmap model" vertex="1">
          <mxGeometry height="300" width="220" x="1535" y="165" as="geometry" />
        </mxCell>
        <mxCell id="ell_e1" edge="1" parent="1" source="ell_input" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#52606d;" target="ell_pre">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ell_e2" edge="1" parent="1" source="ell_pre" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#52606d;" target="ell_encoder">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ell_e3" edge="1" parent="1" source="ell_encoder" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#52606d;" target="ell_decoder">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ell_e4" edge="1" parent="1" source="ell_decoder" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#52606d;" target="ell_heads">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ell_e5" edge="1" parent="1" source="ell_heads" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#52606d;" target="ell_decode">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ell_e6" edge="1" parent="1" source="ell_decode" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#52606d;" target="ell_crop">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arch_title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontStyle=1;fontSize=20;fontColor=#243447;" value="Network structure" vertex="1">
          <mxGeometry height="34" width="180" x="30" y="530" as="geometry" />
        </mxCell>
        <mxCell id="arch_input" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontColor=#243447;" value="&lt;b&gt;Ellipse input&lt;/b&gt;&lt;br&gt;384×384×1" vertex="1">
          <mxGeometry height="90" width="130" x="35" y="610" as="geometry" />
        </mxCell>
        <mxCell id="arch_e1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#e1f0ff;strokeColor=#6c8ebf;fontSize=14;fontColor=#243447;" value="&lt;b&gt;E1&lt;/b&gt;&lt;br&gt;192×192×24" vertex="1">
          <mxGeometry height="90" width="140" x="195" y="610" as="geometry" />
        </mxCell>
        <mxCell id="arch_e2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#e1f0ff;strokeColor=#6c8ebf;fontSize=14;fontColor=#243447;" value="&lt;b&gt;E2&lt;/b&gt;&lt;br&gt;96×96×32" vertex="1">
          <mxGeometry height="90" width="140" x="355" y="610" as="geometry" />
        </mxCell>
        <mxCell id="arch_e3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#e1f0ff;strokeColor=#6c8ebf;fontSize=14;fontColor=#243447;" value="&lt;b&gt;E3&lt;/b&gt;&lt;br&gt;48×48×48" vertex="1">
          <mxGeometry height="90" width="140" x="515" y="610" as="geometry" />
        </mxCell>
        <mxCell id="arch_e4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#e1f0ff;strokeColor=#6c8ebf;fontSize=14;fontColor=#243447;" value="&lt;b&gt;E4&lt;/b&gt;&lt;br&gt;24×24×64" vertex="1">
          <mxGeometry height="90" width="140" x="675" y="610" as="geometry" />
        </mxCell>
        <mxCell id="arch_e5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#e1f0ff;strokeColor=#6c8ebf;fontSize=14;fontColor=#243447;" value="&lt;b&gt;E5&lt;/b&gt;&lt;br&gt;12×12×96" vertex="1">
          <mxGeometry height="90" width="140" x="835" y="610" as="geometry" />
        </mxCell>
        <mxCell id="arch_e6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#e1f0ff;strokeColor=#6c8ebf;fontSize=14;fontColor=#243447;" value="&lt;b&gt;E6 bottleneck&lt;/b&gt;&lt;br&gt;6×6×128" vertex="1">
          <mxGeometry height="90" width="150" x="995" y="610" as="geometry" />
        </mxCell>
        <mxCell id="arch_scale" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontColor=#243447;" value="&lt;b&gt;Scale-score branch&lt;/b&gt;&lt;br&gt;Global average pool&lt;br&gt;Dense(3) → softmax" vertex="1">
          <mxGeometry height="100" width="220" x="1180" y="605" as="geometry" />
        </mxCell>
        <mxCell id="arch_u12" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=7;fillColor=#e6dff0;strokeColor=#9673a6;fontSize=13;fontColor=#243447;" value="&lt;b&gt;U12&lt;/b&gt;&lt;br&gt;12×12×48&lt;br&gt;Upsample + join E5" vertex="1">
          <mxGeometry height="100" width="150" x="1000" y="825" as="geometry" />
        </mxCell>
