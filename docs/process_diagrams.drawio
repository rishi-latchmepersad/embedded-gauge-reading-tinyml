          <mxGeometry height="30" width="350" y="60" as="geometry" />
        </mxCell>
        <mxCell id="LBQWEnL1_VHaJIz2CVFE-1" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;img src=&quot;data:image/svg+xml;base64,&quot; alt=&quot;Image preview&quot;&gt;" vertex="1">
