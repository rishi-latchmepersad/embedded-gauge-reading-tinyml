  </diagram>
  <diagram id="classicalCVBaseline01" name="Classical_CV_Baseline_Process">
    <mxGraphModel dx="964" dy="674" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="cv_title_tech" value="How our classical comparator works" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontStyle=1;fontSize=16;" parent="1" vertex="1">
          <mxGeometry y="30" width="560" height="30" as="geometry" />
        </mxCell>
        <mxCell id="cv_tech_1" value="Start with the accepted gauge image&lt;br&gt;- We use the same image that goes to the AI reader&lt;br&gt;- We do not run the comparator on an image that failed the quality check&lt;br&gt;- This gives us an independent second opinion" style="rounded=1;whiteSpace=wrap;html=1;align=center;fillColor=#d5e8d4;strokeColor=#82b366;image=process_diagrams_assets/cv_01_yuv422_snapshot.svg;imageAlign=right;imageVerticalAlign=middle;imageWidth=48;imageHeight=48;spacingRight=58;spacingLeft=10;" parent="1" vertex="1">
          <mxGeometry x="40" y="90" width="240" height="200" as="geometry" />
        </mxCell>
        <mxCell id="cv_tech_2" value="Try a simple template first&lt;br&gt;- We make a small normalized description of the gauge&lt;br&gt;- We compare it with the expected face&lt;br&gt;- A strong match gives us a quick candidate&lt;br&gt;- A weak match moves on to the more flexible checks" style="rounded=1;whiteSpace=wrap;html=1;align=center;fillColor=#d5e8d4;strokeColor=#82b366;image=process_diagrams_assets/cv_02_center_hypotheses.svg;imageAlign=right;imageVerticalAlign=middle;imageWidth=48;imageHeight=48;spacingRight=58;spacingLeft=10;" parent="1" vertex="1">
          <mxGeometry x="320" y="90" width="320" height="200" as="geometry" />
        </mxCell>
        <mxCell id="cv_tech_3" value="Try several ways to find the needle&lt;br&gt;- We test different possible gauge centers&lt;br&gt;- We look for a dark radial line that starts near the hub and reaches toward the scale&lt;br&gt;- We compare the candidates instead of trusting the first line we find&lt;br&gt;- If the image is low contrast or cluttered, we fail closed" style="rounded=1;whiteSpace=wrap;html=1;align=center;fillColor=#d5e8d4;strokeColor=#82b366;image=process_diagrams_assets/cv_03_hough_votes.svg;imageAlign=right;imageVerticalAlign=middle;imageWidth=48;imageHeight=48;spacingRight=58;spacingLeft=10;" parent="1" vertex="1">
          <mxGeometry x="680" y="90" width="320" height="200" as="geometry" />
        </mxCell>
        <mxCell id="cv_tech_4" value="Refine the best candidate&lt;br&gt;- We make small adjustments around each promising center and angle&lt;br&gt;- We choose the candidate with the strongest evidence and best agreement&lt;br&gt;- A last-resort search is used only when the primary checks fail" style="rounded=1;whiteSpace=wrap;html=1;align=center;fillColor=#d5e8d4;strokeColor=#82b366;image=process_diagrams_assets/cv_04_confidence_selection.svg;imageAlign=right;imageVerticalAlign=middle;imageWidth=48;imageHeight=48;spacingRight=58;spacingLeft=10;" parent="1" vertex="1">
          <mxGeometry x="1030" y="90" width="320" height="200" as="geometry" />
        </mxCell>
        <mxCell id="cv_tech_5" value="Reject uncertain comparator readings&lt;br&gt;- We check confidence, separation, movement, and candidate validity&lt;br&gt;- An unstable result is reported as a failure&lt;br&gt;- We do not turn a weak classical guess into a trusted measurement" style="rounded=1;whiteSpace=wrap;html=1;align=center;fillColor=#d5e8d4;strokeColor=#82b366;image=process_diagrams_assets/cv_05_threshold_gate.svg;imageAlign=right;imageVerticalAlign=middle;imageWidth=48;imageHeight=48;spacingRight=58;spacingLeft=10;" parent="1" vertex="1">
          <mxGeometry x="1390" y="90" width="300" height="200" as="geometry" />
        </mxCell>
        <mxCell id="cv_tech_6" value="Publish diagnostic estimate or fail closed&lt;br&gt;- Accepted baseline frames log RAW angle/source and candidate quality&lt;br&gt;- The active profile supplies signed endpoints, quantity, and unit&lt;br&gt;- Baseline remains a separate classical comparator; the trusted live reading is the AI profile-mapped result&lt;br&gt;- Invalid or unstable baseline candidates publish no fabricated value" style="rounded=1;whiteSpace=wrap;html=1;align=center;fillColor=#d5e8d4;strokeColor=#82b366;image=process_diagrams_assets/cv_06_angle_to_temperature.svg;imageAlign=right;imageVerticalAlign=middle;imageWidth=48;imageHeight=48;spacingRight=58;spacingLeft=10;" parent="1" vertex="1">
          <mxGeometry x="1730" y="90" width="290" height="200" as="geometry" />
        </mxCell>
        <mxCell id="cv_why_1" value="The comparator sees exactly what the AI reader sees. That makes the comparison fair and keeps a classical mistake from changing the AI input." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
          <mxGeometry x="40" y="480" width="240" height="220" as="geometry" />
        </mxCell>
        <mxCell id="cv_why_2" value="The simple check is useful when it works, but it can produce a plausible-looking wrong angle. We only trust it when the evidence is strong." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
          <mxGeometry x="320" y="480" width="320" height="220" as="geometry" />
        </mxCell>
        <mxCell id="cv_why_3" value="This gives us a transparent second opinion. It is useful for diagnosis because we can see why it chose a center or angle, even though it is not the main learned reader." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
          <mxGeometry x="680" y="480" width="310" height="220" as="geometry" />
        </mxCell>
        <mxCell id="cv_why_4" value="We keep a more flexible search as a last resort. It may recover a difficult image, but we do not want it overriding stronger evidence from the earlier checks." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
          <mxGeometry x="1030" y="480" width="320" height="220" as="geometry" />
        </mxCell>
        <mxCell id="cv_why_5" value="We would rather say that a frame failed than show a confident-looking wrong value. Image quality and geometry failures stay visible in the logs." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
          <mxGeometry x="1390" y="480" width="300" height="220" as="geometry" />
        </mxCell>
        <mxCell id="cv_why_6" value="This comparator helps us understand failures, but the AI profile-mapped result is the trusted reading path. We keep both results separate so a bad comparator value cannot hide a problem in the real pipeline." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
          <mxGeometry x="1730" y="470" width="290" height="220" as="geometry" />
        </mxCell>
        <mxCell id="cve1" style="endArrow=block;html=1;strokeColor=#000000;" parent="1" source="cv_tech_1" target="cv_tech_2" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cve2" style="endArrow=block;html=1;strokeColor=#000000;" parent="1" source="cv_tech_2" target="cv_tech_3" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cve3" style="endArrow=block;html=1;strokeColor=#000000;" parent="1" source="cv_tech_3" target="cv_tech_4" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cve4" style="endArrow=block;html=1;strokeColor=#000000;" parent="1" source="cv_tech_4" target="cv_tech_5" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cve5" style="endArrow=block;html=1;strokeColor=#000000;" parent="1" source="cv_tech_5" target="cv_tech_6" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cvw2" style="dashed=1;endArrow=none;html=1;strokeColor=#d79b00;" parent="1" source="kAxTJiGilQFAcQdgw8WS-3" target="cv_why_2" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cvw3" style="dashed=1;endArrow=none;html=1;strokeColor=#d79b00;" parent="1" source="kAxTJiGilQFAcQdgw8WS-5" target="cv_why_3" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cvw4" style="dashed=1;endArrow=none;html=1;strokeColor=#d79b00;" parent="1" target="cv_why_4" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1190" y="433" as="sourcePoint" />
