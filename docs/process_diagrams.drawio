        <mxCell id="cnn_w6" edge="1" parent="1" style="dashed=1;endArrow=none;html=1;strokeColor=#d79b00;" target="cnn_why_6">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1820" y="435.5" as="sourcePoint" />
