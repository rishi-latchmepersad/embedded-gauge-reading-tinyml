        <mxCell id="V077Ls7bwzFt84BWvUJ_-1" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontStyle=1;fontSize=16;" value="Current Live AI + Capture Process Steps" vertex="1">
          <mxGeometry height="30" width="350" y="60" as="geometry" />
        </mxCell>
