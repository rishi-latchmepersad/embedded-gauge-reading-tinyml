  <diagram id="keypointModelV1" name="Keypoint_Model">
    <mxGraphModel dx="1885" dy="1121" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1820" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="kp_title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontStyle=1;fontSize=26;fontColor=#243447;" value="Center/Tip Keypoint Model Architecture" vertex="1">
          <mxGeometry height="44" width="1500" x="40" y="28" as="geometry" />
        </mxCell>
        <mxCell id="kp_subtitle" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;fontColor=#52606d;" value="The second model in the deployed pipeline: use the ellipse crop to locate the gauge center and needle tip, then convert their geometry into a reading." vertex="1">
          <mxGeometry height="34" width="1680" x="40" y="78" as="geometry" />
        </mxCell>
        <mxCell id="lBHPenk02jIwHuTNXTHN-1" edge="1" parent="1" source="kp_input" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="250" y="329.66666666666674" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="kp_input" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontColor=#243447;" value="&lt;b&gt;Stage 1 ellipse crop&lt;/b&gt;&lt;br&gt;224 × 224&lt;br&gt;MONO_Y8&lt;br&gt;One grayscale channel&lt;br&gt;&lt;br&gt;(The face-localized square crop is resized to a fixed model input and quantized to signed int8 in firmware)" vertex="1">
          <mxGeometry height="300" width="180" x="40" y="180" as="geometry" />
        </mxCell>
        <mxCell id="lBHPenk02jIwHuTNXTHN-2" edge="1" parent="1" source="kp_encoder" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="kp_decoder">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="kp_encoder" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;fillColor=#e1f0ff;strokeColor=#6c8ebf;fontSize=14;fontColor=#243447;" value="&lt;b&gt;Shared U-Net encoder&lt;/b&gt;&lt;br&gt;Five downsample + refine stages&lt;br&gt;Each stage uses 3 × 3 Conv + BN + ReLU blocks&lt;br&gt;&lt;br&gt;&lt;br&gt;Channels: 48 → 72 → 96 → 144 → 192&lt;br&gt;Features: 112 → 56 → 28 → 14 → 7&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;(Apply the convolution filter to learn abstract features, losing finer details in each convolution but keeping skip features)&lt;/div&gt;" vertex="1">
          <mxGeometry height="300" width="245" x="255" y="180" as="geometry" />
        </mxCell>
        <mxCell id="lBHPenk02jIwHuTNXTHN-3" edge="1" parent="1" source="kp_decoder" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="kp_heatmaps">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="kp_decoder" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;fillColor=#e6dff0;strokeColor=#9673a6;fontSize=14;fontColor=#243447;" value="&lt;b&gt;U-Net decoder&lt;/b&gt;&lt;br&gt;Three bilinear ×2 upsample stages&lt;br&gt;&lt;br&gt;Concatenate encoder skip features at 14, 28, and 56 scales&lt;br&gt;&lt;br&gt;(Use the skip features and the upsampled features to find spatial details in the gauge. Refine the final 56 × 56 features before prediction)" vertex="1">
          <mxGeometry height="300" width="240" x="530" y="180" as="geometry" />
        </mxCell>
        <mxCell id="lBHPenk02jIwHuTNXTHN-4" edge="1" parent="1" source="kp_heatmaps" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="kp_decode">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="kp_heatmaps" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontColor=#243447;" value="&lt;b&gt;One heatmap output tensor&lt;/b&gt;&lt;br&gt;56 × 56 × 2&lt;br&gt;&lt;br&gt;Channel 0: center&lt;br&gt;Channel 1: needle tip&lt;br&gt;&lt;br&gt;One 1 × 1 sigmoid convolution; no separate scalar confidence output&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;(Convert the features into a heatmap, showing how center-like and tip-like each heatmap cell seems to be)&amp;nbsp;&lt;/div&gt;" vertex="1">
          <mxGeometry height="300" width="220" x="800" y="180" as="geometry" />
        </mxCell>
        <mxCell id="lBHPenk02jIwHuTNXTHN-5" edge="1" parent="1" source="kp_decode" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="kp_reading">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="kp_decode" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;fillColor=#fce5cd;strokeColor=#d79b00;fontSize=14;fontColor=#243447;" value="&lt;b&gt;Decode center and tip&lt;/b&gt;&lt;br&gt;For each map, use a weighted centroid:&lt;br&gt;w = max(p − 0.03, 0)²&lt;br&gt;&lt;br&gt;(Convert heatmap cells to crop coordinates using the 56 × 56 grid)" vertex="1">
          <mxGeometry height="300" width="285" x="1060" y="179" as="geometry" />
        </mxCell>
        <mxCell id="kp_reading" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontColor=#243447;" value="&lt;b&gt;Validate and read the gauge&lt;/b&gt;&lt;br&gt;Reject if either heatmap peak is below 0.03 or center–tip separation is under 48 source pixels&lt;br&gt;&lt;br&gt;(Map coordinates from the 224x224 model input back to the 640 × 640 frame; compute a north-zero needle angle; apply the gauge calibration)" vertex="1">
          <mxGeometry height="300" width="260" x="1400" y="179" as="geometry" />
        </mxCell>
        <mxCell id="kp_arch_title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontStyle=1;fontSize=20;fontColor=#243447;" value="Network structure" vertex="1">
          <mxGeometry height="34" width="1100" x="40" y="510" as="geometry" />
        </mxCell>
        <mxCell id="kp_arch_note" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#52606d;" value="Deployed width multiplier α = 1.5. Dashed blue arrows show the three skip concatenations; the 112 × 112 encoder feature is not used as a decoder skip in this exported model." vertex="1">
          <mxGeometry height="30" width="1680" x="40" y="545" as="geometry" />
        </mxCell>
        <mxCell id="kp_arch_input" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=7;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontColor=#243447;" value="&lt;b&gt;Crop input&lt;/b&gt;&lt;br&gt;224 × 224 × 1" vertex="1">
          <mxGeometry height="90" width="130" x="35" y="610" as="geometry" />
        </mxCell>
        <mxCell id="kp_e1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=7;fillColor=#e1f0ff;strokeColor=#6c8ebf;fontSize=13;fontColor=#243447;" value="&lt;b&gt;E1&lt;/b&gt;&lt;br&gt;112 × 112 × 48" vertex="1">
          <mxGeometry height="90" width="140" x="195" y="610" as="geometry" />
        </mxCell>
        <mxCell id="kp_e2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=7;fillColor=#e1f0ff;strokeColor=#6c8ebf;fontSize=13;fontColor=#243447;" value="&lt;b&gt;E2&lt;/b&gt;&lt;br&gt;56 × 56 × 72" vertex="1">
          <mxGeometry height="90" width="140" x="355" y="610" as="geometry" />
        </mxCell>
        <mxCell id="kp_e3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=7;fillColor=#e1f0ff;strokeColor=#6c8ebf;fontSize=13;fontColor=#243447;" value="&lt;b&gt;E3&lt;/b&gt;&lt;br&gt;28 × 28 × 96" vertex="1">
          <mxGeometry height="90" width="140" x="515" y="610" as="geometry" />
        </mxCell>
        <mxCell id="kp_e4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=7;fillColor=#e1f0ff;strokeColor=#6c8ebf;fontSize=13;fontColor=#243447;" value="&lt;b&gt;E4&lt;/b&gt;&lt;br&gt;14 × 14 × 144" vertex="1">
          <mxGeometry height="90" width="140" x="675" y="610" as="geometry" />
        </mxCell>
        <mxCell id="kp_bottleneck" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=7;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontColor=#243447;" value="&lt;div&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(36, 52, 71), rgb(182, 196, 212));&quot;&gt;Bottleneck&lt;/b&gt;&lt;/div&gt;7 × 7 × 192" vertex="1">
          <mxGeometry height="90" width="140" x="835" y="610" as="geometry" />
        </mxCell>
        <mxCell id="kp_arch_legend" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#f5f5f5;strokeColor=#999999;fontSize=13;fontColor=#243447;" value="Solid arrows: feature flow&lt;br&gt;Dashed blue arrows: skip features concatenated into decoder&lt;br&gt;The network returns two heatmaps, not a confidence or direction scalar." vertex="1">
          <mxGeometry height="100" width="440" x="1220" y="720" as="geometry" />
